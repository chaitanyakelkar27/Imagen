# ==========================================
# Imagen Application Environment Variables
# ==========================================
# Copy this file to:
#   - `server/.env` for backend configuration
#   - `client/.env` for frontend configuration

# ------------------------------------------
# Server Environment Variables (server/.env)
# ------------------------------------------

# Environment Mode
NODE_ENV=development
PORT=5000

# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/imagen

# Secrets (Use long random strings in production)
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Application URLs
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Google OAuth Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Third-Party AI API Keys
CLIPDROP_API=your_clipdrop_api_key_here

# Gmail SMTP for password reset emails
# Step 1: Enable 2-Step Verification on your Google account
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Create an App Password and use the 16-char code below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM=Imagen <your_gmail@gmail.com>

# ------------------------------------------
# Client Environment Variables (client/.env)
# ------------------------------------------

# Backend API URL (must be your deployed server URL in production)
VITE_BACKEND_URL=http://localhost:5000