# Root/shared environment example
# Use this file for non-secret defaults shared across the repo
# Put secrets and service-specific values in the service-level
# example files: `server/.env.example` and `client/.env.example`.

# URL where the frontend is served
CLIENT_URL=http://localhost:3000

# URL where the backend/server is served
SERVER_URL=http://localhost:5000

# Default database name (server should use a full connection string)
MONGO_DATABASE=imagen

# NOTE: Do NOT place real secrets here. See `server/.env.example`
# for JWT, DB connection string, and third-party API keys.