# Server environment example (DO NOT commit real secrets)
# Copy this file to `server/.env` and replace placeholders with real values.

# Full MongoDB connection URI (include username/password when required)
MONGODB_URI=mongodb://<user>:<pass>@host:port/db

# Application secrets
JWT_SECRET=replace_with_strong_random_value
SESSION_SECRET=replace_with_session_secret

# CORS and URLs
CORS_ORIGIN=http://localhost:3000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Google OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Third-party APIs
CLIPDROP_API=your_clipdrop_api_key_here

# Instructions:
# 1. Copy this file to server/.env (or create server/.env locally)
# 2. Replace placeholders with your actual credentials
# 3. Never commit the .env file to git
